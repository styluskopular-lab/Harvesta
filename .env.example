# Application
APP_NAME=Harvesta
APP_VERSION=1.0.0
DEBUG=False
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Local SQLite is used when DATABASE_URL is unset.
DATABASE_URL=sqlite:///./harvesta.db

# Streamlit frontend API base URL
BACKEND_API_URL=http://localhost:8000

# Notification providers (optional; notifications are logged when unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Or Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","http://127.0.0.1:8501"]
